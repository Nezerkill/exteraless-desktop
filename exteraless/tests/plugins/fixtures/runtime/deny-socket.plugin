from base_plugin import BasePlugin

import socket

__id__ = "deny_socket"
__name__ = "Deny Socket"
__version__ = "1.0.0"
__permissions__ = ["network"]


class DenySocket(BasePlugin):
    def on_load(self):
        try:
            sock = socket.socket()
            sock.connect(("127.0.0.1", 9))
            sock.close()
        except (PermissionError, OSError):
            self.log("socket denied")


plugin = DenySocket()
