+    search = parse_search("lrclib-broken.json")
+    if search is not None:
+        ledger.check("lrclib search broken empty", search == [], search)
+
+    result = run(
+        cli, ["lyrics-get-parse", str(FIXTURES / "missing-lrclib.json")])
