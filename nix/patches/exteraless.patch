+class _PluginLoader(importlib.machinery.SourceFileLoader):
+    def __init__(self, fullname, path, data):
+        super().__init__(fullname, path)
+        self._data = data
+
+    def get_data(self, path):
+        if _real(path) == _real(self.path):
+            return self._data
+        return super().get_data(path)
+
+    def get_code(self, fullname):
+        source = importlib.util.decode_source(self._data)
+        _ALLOW_COMPILE[0] = True
+        try:
+            code = compile(source, self.path, 'exec')
+        finally:
+            _ALLOW_COMPILE[0] = False
+        _LOAD_CODE[0] = code
+        return code
+
+
+def _module_under_root(name):
+    module = sys.modules.get(name)
+    filename = getattr(module, '__file__', None) if module is not None else None
+    return isinstance(filename, str) and _under(filename, (ROOT,))
+
+
+def _purge(names):
+    for name in set(names):
+        if _module_under_root(name):
+            sys.modules.pop(name, None)
+
+
+def _find_plugin(module):
+    candidate = getattr(module, 'plugin', None)
+    if isinstance(candidate, BasePlugin):
+        return candidate, ''
+    instances = []
+    subclasses = []
+    for value in vars(module).values():
+        if isinstance(value, BasePlugin):
+            instances.append(value)
+        elif (isinstance(value, type)
+              and value is not BasePlugin
+              and issubclass(value, BasePlugin)):
+            subclasses.append(value)
+    if len(instances) > 1:
+        return None, 'Plugin declares more than one BasePlugin instance.'
+    if len(instances) == 1:
+        return instances[0], ''
+    if len(subclasses) > 1:
+        return None, 'Plugin declares more than one BasePlugin subclass.'
+    if len(subclasses) == 1:
+        try:
+            return subclasses[0](), ''
+        except BaseException as error:
+            return None, 'Plugin could not be created: %s' % error
+    return None, 'Plugin must declare a BasePlugin instance or subclass.'
+
+
+def _bounded_text(value, limit=200):
+    if not isinstance(value, str):
+        return ''
+    return value[:limit]
+
+
+def _sanitize_settings(value):
+    if not isinstance(value, dict):
+        return {}
+    result = {}
+    total = 0
+    for key, item in value.items():
+        if not isinstance(key, str) or not key or len(key) > 64:
+            continue
+        if len(result) >= MAX_SETTING_KEYS:
+            break
+        safe = _json_safe(item)
+        if safe is _InvalidJson:
+            continue
+        size = len(json.dumps(safe, ensure_ascii=False).encode('utf-8'))
+        if total + size > MAX_SETTINGS_BYTES:
+            continue
+        result[key] = safe
+        total += size
+    return result
+
+
+def _settings_snapshot(plugin_id):
+    values = _SETTINGS.get(plugin_id)
+    return _sanitize_settings(values) if isinstance(values, dict) else {}
+
+
+def _restore_settings(plugin_id, previous):
+    if previous is None:
+        _SETTINGS.pop(plugin_id, None)
+    else:
+        _SETTINGS[plugin_id] = previous
+
+
+def _menu_text(value):
+    if not isinstance(value, str):
+        return ''
+    text = value.strip()
+    if not text or len(text) > MAX_MENU_TEXT:
+        return ''
+    if any(ord(char) < 32 or ord(char) == 127 for char in text):
+        return ''
+    return text
+
+
+def _menu_entry(item, context):
+    if not isinstance(context, str) or context not in MENU_CONTEXTS:
+        return None
+    item_id = getattr(item, 'item_id', None)
+    if not isinstance(item_id, str) or not MENU_ITEM_RE.match(item_id):
+        return None
+    text = _menu_text(getattr(item, 'text', None))
+    if not text:
+        return None
+    priority = getattr(item, 'priority', 0)
+    priority = (priority if isinstance(priority, int)
+                and not isinstance(priority, bool) else 0)
+    entry = {
+        'item_id': item_id,
+        'text': text,
+        'priority': max(-MAX_MENU_PRIORITY,
+                        min(MAX_MENU_PRIORITY, priority)),
+        'context': context,
+    }
+    subtext = _menu_text(getattr(item, 'subtext', None))
+    if subtext:
+        entry['subtext'] = subtext
+    return entry
+
+
+def _menu_snapshot(plugin_id):
+    entries = _MENUS.get(plugin_id)
+    if not isinstance(entries, list):
+        return []
+    result = []
+    for entry in entries[:MAX_MENU_ITEMS]:
+        clean = {
+            'item_id': entry['item_id'],
+            'text': entry['text'],
+            'priority': entry['priority'],
+            'context': entry['context'],
+        }
+        if entry.get('subtext'):
+            clean['subtext'] = entry['subtext']
+        result.append(clean)
+    return result
+
+
+def _setting_field(item, name, fallback=None):
+    if isinstance(item, dict):
+        return item.get(name, fallback)
+    return getattr(item, name, fallback)
+
+
+def _setting_entry(item, plugin_id):
+    kind = _setting_field(item, 'type')
+    if kind == 'header':
+        text = _bounded_text(_setting_field(item, 'text'))
+        return {'type': 'header', 'text': text} if text else None
+    if kind == 'divider':
+        entry = {'type': 'divider'}
+        text = _bounded_text(_setting_field(item, 'text'))
+        if text:
+            entry['text'] = text
+        return entry
+    if kind == 'custom':
+        return {'type': 'custom'}
+    key = _setting_field(item, 'key')
+    if not isinstance(key, str) or not key:
+        return None
+    values = _SETTINGS.get(plugin_id)
+    values = values if isinstance(values, dict) else {}
+    page = _bounded_text(_setting_field(item, 'text'))
+    subtext = _bounded_text(_setting_field(item, 'subtext'))
+    if kind == 'switch':
+        default = bool(_setting_field(item, 'default', False))
+        value = values.get(key, default)
+        entry = {
+            'type': 'switch',
+            'key': key[:64],
+            'text': page,
+            'value': value if isinstance(value, bool) else default,
+        }
+        if subtext:
+            entry['subtext'] = subtext
+        return entry
+    if kind == 'selector':
+        options = _setting_field(item, 'items')
+        if isinstance(options, (list, tuple)):
+            options = [_bounded_text(option) for option in options]
+            options = [option for option in options if option]
+        else:
+            options = []
+        if not options:
+            return None
+        default = _setting_field(item, 'default', 0)
+        default = (default if isinstance(default, int)
+                   and not isinstance(default, bool) else 0)
+        if default < 0 or default >= len(options):
+            default = 0
+        value = values.get(key, default)
+        value = (value if isinstance(value, int)
+                 and not isinstance(value, bool) else default)
+        if value < 0 or value >= len(options):
+            value = default
+        entry = {
+            'type': 'selector',
+            'key': key[:64],
+            'text': page,
+            'items': options,
+            'value': value,
+            'default': default,
+        }
+        if subtext:
+            entry['subtext'] = subtext
+        return entry
+    if kind == 'input':
+        default = _setting_field(item, 'default')
+        default = default if isinstance(default, str) else ''
+        value = values.get(key, default)
+        entry = {
+            'type': 'input',
+            'key': key[:64],
+            'text': page,
+            'value': value if isinstance(value, str) else default,
+        }
+        if subtext:
+            entry['subtext'] = subtext
+        return entry
+    return None
+
+
+def _settings_rows(instance, plugin_id):
+    creator = getattr(instance, 'create_settings', None)
+    if not callable(creator):
+        return []
+    try:
+        items = creator()
+    except BaseException:
+        return []
+    if not isinstance(items, (list, tuple)):
+        return []
+    rows = []
+    for item in items[:128]:
+        entry = None
+        try:
+            entry = _setting_entry(item, plugin_id)
+        except Exception:
+            entry = None
+        if entry is not None:
+            rows.append(entry)
+    return rows
+
+
+def _load(message):
+    seq = _CURRENT_SEQ[0]
+    plugin_id = message.get('id')
+    if not isinstance(plugin_id, str) or not ID_RE.match(plugin_id):
+        _send({'seq': seq, 'type': 'error', 'message': 'Invalid plugin id.'})
+        return
+    path = message.get('path')
+    if not isinstance(path, str) or not os.path.isabs(path):
+        _send({'seq': seq, 'type': 'error',
+               'message': 'Plugin path is not absolute.'})
+        return
+    real = _real(path)
+    if os.path.dirname(real) != ROOT:
+        _send({'seq': seq, 'type': 'error',
+               'message': 'Plugin path is outside the plugins directory.'})
+        return
+    if not real.lower().endswith(SUPPORTED):
+        _send({'seq': seq, 'type': 'error',
+               'message': 'Unsupported plugin format.'})
+        return
+    if os.path.islink(path):
+        _send({'seq': seq, 'type': 'error',
+               'message': 'Plugin path is a symlink.'})
+        return
+    try:
+        info = os.stat(path, follow_symlinks=False)
+    except OSError as error:
+        _send({'seq': seq, 'type': 'error',
+               'message': 'Plugin file is missing: %s' % error})
+        return
+    if not stat.S_ISREG(info.st_mode):
+        _send({'seq': seq, 'type': 'error',
+               'message': 'Plugin path is not a regular file.'})
+        return
+    flags = (os.O_RDONLY
+             | getattr(os, 'O_NOFOLLOW', 0)
+             | getattr(os, 'O_BINARY', 0))
+    try:
+        descriptor = os.open(path, flags)
+    except OSError as error:
+        _send({'seq': seq, 'type': 'error',
+               'message': 'Plugin file could not be opened: %s' % error})
+        return
+    chunks = []
+    total = 0
+    try:
+        info = os.fstat(descriptor)
+        if not stat.S_ISREG(info.st_mode):
+            _send({'seq': seq, 'type': 'error',
+                   'message': 'Plugin path is not a regular file.'})
+            return
+        if info.st_size > MAX_BYTES:
+            _send({'seq': seq, 'type': 'error',
+                   'message': 'Plugin file is larger than 2 MiB.'})
+            return
+        while True:
+            chunk = os.read(descriptor, 65536)
+            if not chunk:
+                break
+            total += len(chunk)
+            if total > MAX_BYTES:
+                _send({'seq': seq, 'type': 'error',
+                       'message': 'Plugin file is larger than 2 MiB.'})
+                return
+            chunks.append(chunk)
+    finally:
+        os.close(descriptor)
+    data = b''.join(chunks)
+
+    existing = _PLUGINS.get(plugin_id)
+    if existing is not None:
+        if existing['path'] == real:
+            _SETTINGS[plugin_id] = _sanitize_settings(
+                message.get('settings'))
+            _send({
+                'seq': seq,
+                'type': 'loaded',
+                'ok': True,
+                'settings': _settings_snapshot(plugin_id),
+                'settings_ui': _settings_rows(
+                    existing['instance'], plugin_id),
+                'menu': _menu_snapshot(plugin_id),
+            })
+        else:
+            _send({'seq': seq, 'type': 'error',
+                   'message': 'Plugin id is already loaded from another path.'})
+        return
+
+    previous_settings = _SETTINGS.get(plugin_id)
+    _SETTINGS[plugin_id] = _sanitize_settings(message.get('settings'))
+    _MENUS.pop(plugin_id, None)
+    module_name = 'exteraless_plugin_' + plugin_id
+    before = set(sys.modules)
+    _CURRENT_ID[0] = plugin_id
+    try:
+        loader = _PluginLoader(module_name, real, data)
+        spec = importlib.util.spec_from_file_location(
+            module_name, real, loader=loader)
+        module = importlib.util.module_from_spec(spec)
+        sys.modules[module_name] = module
+        spec.loader.exec_module(module)
+    except BaseException as error:
+        sys.modules.pop(module_name, None)
+        _purge(set(sys.modules) - before)
+        _restore_settings(plugin_id, previous_settings)
+        _send({'seq': seq, 'type': 'error',
+               'message': 'Plugin load failed: %s' % error})
+        return
+    finally:
+        _LOAD_CODE[0] = None
+
+    instance, error = _find_plugin(module)
+    if error:
+        _purge({module_name})
+        _restore_settings(plugin_id, previous_settings)
+        _send({'seq': seq, 'type': 'error', 'message': error})
+        return
+    declared = getattr(module, '__id__', None)
+    if declared != plugin_id:
+        _purge({module_name})
+        _restore_settings(plugin_id, previous_settings)
+        _send({'seq': seq, 'type': 'error',
+               'message': 'Plugin id mismatch: expected %s, got %s.' % (
+                   plugin_id, declared)})
+        return
+
+    modules = {
+        name for name in set(sys.modules) - before if _module_under_root(name)
+    }
+    modules.add(module_name)
+    record = {
+        'module': module,
+        'instance': instance,
+        'path': real,
+        'modules': modules,
+    }
+    _PLUGINS[plugin_id] = record
+    try:
+        instance.on_load()
+    except BaseException as error:
+        _PLUGINS.pop(plugin_id, None)
+        try:
+            instance.on_unload()
+        except BaseException:
+            pass
+        _purge(modules)
+        _restore_settings(plugin_id, previous_settings)
+        _send({'seq': seq, 'type': 'error',
+               'message': 'Plugin load failed: %s' % error})
+        return
+    _send({
+        'seq': seq,
+        'type': 'loaded',
+        'ok': True,
+        'settings': _settings_snapshot(plugin_id),
+        'settings_ui': _settings_rows(instance, plugin_id),
+        'menu': _menu_snapshot(plugin_id),
+    })
+
+
+def _unload(message):
+    seq = _CURRENT_SEQ[0]
+    plugin_id = message.get('id')
+    record = None
+    if isinstance(plugin_id, str):
+        record = _PLUGINS.pop(plugin_id, None)
+    if record is None:
+        _send({'seq': seq, 'type': 'unloaded', 'ok': True})
+        return
+    warning = ''
+    _CURRENT_ID[0] = plugin_id
+    try:
+        record['instance'].on_unload()
+    except BaseException as error:
+        warning = 'on_unload failed: %s' % error
+    _purge(record['modules'])
+    _SETTINGS.pop(plugin_id, None)
+    _MENUS.pop(plugin_id, None)
+    response = {'seq': seq, 'type': 'unloaded', 'ok': True}
+    if warning:
+        response['warning'] = warning
+    _send(response)
+
+
+def _shutdown():
+    for plugin_id in list(_PLUGINS):
+        record = _PLUGINS.get(plugin_id)
+        if record is None:
+            continue
+        _CURRENT_ID[0] = plugin_id
+        try:
+            record['instance'].on_unload()
+        except BaseException:
+            pass
+        _purge(record['modules'])
+    _PLUGINS.clear()
+    _SETTINGS.clear()
+    _MENUS.clear()
+    _send({'seq': _CURRENT_SEQ[0], 'type': 'bye'})
+
+
+def _menu_click(message):
+    seq = _CURRENT_SEQ[0]
+    plugin_id = message.get('id')
+    record = _PLUGINS.get(plugin_id) if isinstance(plugin_id, str) else None
+    item_id = message.get('item')
+    context = message.get('context')
+    if record is None:
+        _send({'seq': seq, 'type': 'error',
+               'message': 'Plugin is not loaded.'})
+        return
+    entries = _MENUS.get(plugin_id)
+    entries = entries if isinstance(entries, list) else []
+    if not isinstance(item_id, str) or not isinstance(context, str) or not any(
+            entry['item_id'] == item_id and entry['context'] == context
+            for entry in entries):
+        _send({'seq': seq, 'type': 'error',
+               'message': 'Unknown menu item.'})
+        return
+    handler = getattr(record['instance'], 'on_menu_item', None)
+    _CURRENT_ID[0] = plugin_id
+    try:
+        if callable(handler):
+            handler(item_id, context)
+    except BaseException as error:
+        _send({'seq': seq, 'type': 'error',
+               'message': 'Menu action failed: %s' % error})
+        return
+    _send({'seq': seq, 'type': 'clicked', 'ok': True})
+
+
+def _handle(line):
+    try:
+        message = json.loads(line)
+    except ValueError:
+        _send({'seq': 0, 'type': 'error', 'message': 'Invalid command.'})
+        return True
+    if not isinstance(message, dict):
+        _send({'seq': 0, 'type': 'error', 'message': 'Invalid command.'})
+        return True
+    seq = message.get('seq')
+    _CURRENT_SEQ[0] = seq if isinstance(seq, int) else 0
+    command = message.get('cmd')
+    if command == 'shutdown':
+        _shutdown()
+        return False
+    if command == 'load':
+        _load(message)
+    elif command == 'unload':
+        _unload(message)
+    elif command == 'menu':
+        _menu_click(message)
+    else:
+        _send({'seq': _CURRENT_SEQ[0], 'type': 'error',
+               'message': 'Unknown command.'})
+    _CURRENT_ID[0] = ''
+    _CURRENT_SEQ[0] = 0
+    return True
+
+
+KEYCTL_JOIN_SESSION_KEYRING = 1
+KEYCTL_SYSCALL = {
+    'aarch64': 219,
+    'armv7l': 311,
+    'i686': 288,
+    'ppc64le': 240,
+    'riscv64': 219,
+    's390x': 280,
+    'x86_64': 250,
+}
+
+
+def _close_library_fds():
+    # Importing ctypes leaves an fd on libffi; the host keeps only its own.
+    try:
+        names = os.listdir('/proc/self/fd')
+    except OSError:
+        return
+    for name in names:
+        try:
+            target = os.readlink('/proc/self/fd/' + name)
+        except OSError:
+            continue
+        if 'libffi' in target or '_ctypes' in target:
+            try:
+                os.close(int(name))
+            except (OSError, ValueError):
+                pass
+
+
+def _join_session_keyring():
+    # Best-effort: bwrap leaves session keyrings shared, so drop the inherited one.
+    try:
+        import ctypes
+        libc = ctypes.CDLL(None, use_errno=True)
+        symbol = getattr(libc, 'keyctl', None)
+        if symbol is not None:
+            symbol.restype = ctypes.c_long
+            return symbol(
+                KEYCTL_JOIN_SESSION_KEYRING, ctypes.c_ulong(0), 0, 0)
+        number = KEYCTL_SYSCALL.get(os.uname().machine)
+        if number is None:
+            return -1
+        libc.syscall.restype = ctypes.c_long
+        return libc.syscall(
+            ctypes.c_long(number),
+            ctypes.c_long(KEYCTL_JOIN_SESSION_KEYRING),
+            ctypes.c_ulong(0),
+            0,
+            0)
+    except Exception:
+        return -1
+    finally:
+        _close_library_fds()
+
+
+def _install():
+    sys.addaudithook(_audit)
+    base = types.ModuleType('base_plugin')
+    base.BasePlugin = BasePlugin
+    base.HeaderSetting = HeaderSetting
+    base.DividerSetting = DividerSetting
+    base.SwitchSetting = SwitchSetting
+    base.SelectorSetting = SelectorSetting
+    base.InputSetting = InputSetting
+    base.CustomSetting = CustomSetting
+    base.MenuItemData = MenuItemData
+    base.MenuItemType = MenuItemType
+    sys.modules['base_plugin'] = base
+
+
+def main():
+    _join_session_keyring()
+    _install()
+    _send({'type': 'ready', 'api': 1})
+    while True:
+        try:
+            line = INPUT.readline()
+        except OSError:
+            return
+        if not line:
+            return
+        text = line.decode('utf-8', 'replace').strip()
+        if not text:
+            continue
+        if not _handle(text):
+            return
+
+
+main()
