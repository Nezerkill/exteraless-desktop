+def startup_sources():
+    paths = []
+    for entry in STARTUP_SOURCES:
+        if entry.is_dir():
+            paths.extend(sorted(
+                path for path in entry.rglob("*")
+                if path.suffix in (".cpp", ".h", ".mm")))
+        else:
+            paths.append(entry)
+    return paths
