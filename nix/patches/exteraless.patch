+void Config::setChatsRemoveMessageTail(bool value) {
+	setValue(kChatsRemoveMessageTail, value);
+}
+
+void Config::setChatsHideReactionsChannels(bool value) {
+	setValue(kChatsHideReactionsChannels, value);
