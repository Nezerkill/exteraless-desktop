+PROTOCOL = os.fdopen(os.dup(1), 'wb', buffering=0)
+INPUT = os.fdopen(os.dup(0), 'rb', buffering=0)
+_DEVNULL = os.open(os.devnull, os.O_RDWR)
+os.dup2(_DEVNULL, 0)
+os.dup2(_DEVNULL, 1)
+os.dup2(_DEVNULL, 2)
+os.close(_DEVNULL)
