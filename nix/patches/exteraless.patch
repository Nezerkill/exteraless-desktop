+class Ledger:
+    def __init__(self):
+        self.checks = 0
+        self.failures = []
+        self.skips = []
+
+    def check(self, name, condition, detail=""):
+        self.checks += 1
+        if condition:
+            print(f"PASS {name}")
+        else:
+            suffix = f": {detail}" if detail else ""
+            print(f"FAIL {name}{suffix}")
+            self.failures.append(name)
+
+    def skip(self, name, detail=""):
+        suffix = f": {detail}" if detail else ""
+        print(f"SKIP {name}{suffix}")
+        self.skips.append(name)
+
