+        ledger.check("unsynced lyrics synced false", payload["synced"] is False)
+        ledger.check("unsynced lyrics single line", len(lines) == 1, len(lines))
+        text = lines[0]["text"] if lines else None
+        ledger.check(
+            "unsynced lyrics joined text",
