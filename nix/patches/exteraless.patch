+        ])
+        self.log("fork-proc1-nix-rc=%d" % nix)
+        mount = spawn([
+            sys.executable.encode(), b"-I", b"-B", b"-c",
+            MOUNT_CODE.encode(),
+        ])
+        self.log("fork-mount-rc=%d" % mount)
+        net = spawn([
+            sys.executable.encode(), b"-I", b"-B", b"-c",
+            NET_CODE.encode(),
+        ])
+        self.log("fork-net-rc=%d" % net)
+
+
+plugin = EscapeFork()
