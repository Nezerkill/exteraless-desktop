+def _deny(event, detail):
+    _send({
+        'seq': _CURRENT_SEQ[0],
+        'type': 'audit',
+        'id': _CURRENT_ID[0],
+        'event': event,
+        'detail': str(detail)[:500],
+    })
+    raise PermissionError('Exteraless audit: %s denied' % event)
