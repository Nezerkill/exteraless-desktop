+def workspace(work, name):
+    base = work / name
+    plugins = base / "plugins"
+    tdata = base / "tdata"
+    plugins.mkdir(parents=True)
+    tdata.mkdir()
+    return base, plugins, tdata / "plugins-audit.log"
