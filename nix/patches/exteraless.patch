+	addProxyCondition(
+		Exteraless::ProxyCondition::Mobile,
+		u"exteraless/proxy/mobile"_q,
+		tr::lng_settings_exteraless_proxy_mobile(),
+		{ u"mobile"_q, u"cellular"_q, u"proxy"_q });
+	addProxyCondition(
