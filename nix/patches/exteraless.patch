+	const auto weak = base::make_weak(list.get());
+	for (const auto &record : items) {
+		const auto pluginId = record.pluginId;
+		const auto itemId = record.itemId;
+		menu->addAction(record.text, [=] {
+			const auto strong = weak.get();
+			if (!strong) {
+				return;
