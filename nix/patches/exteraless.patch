+
+const auto kMeta = Builder::BuildHelper({
+	.id = ExteralessSection::Id(),
+	.parentId = MainId(),
+	.title = &tr::lng_settings_exteraless,
+	.icon = &st::menuIconSettings,
+}, [](Builder::SectionBuilder &builder) {
+	builder.addSubsectionTitle({
