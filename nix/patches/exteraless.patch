+	setMouseTracking(true);
+	setCursor(Qt::PointingHandCursor);
+	setFixedHeight(st::dialogsFilter.heightMin);
+
+	_netTimer.start();
+	_enabled = Config::Instance().pillStackEnabled();
+	_pillsMask = Config::Instance().pillStackPills();
