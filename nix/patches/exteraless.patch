+    if reloaded is not None:
+        ledger.check(
+            "update channel alias value",
+            reloaded.get("channel") == 2,
+            reloaded)
+
+    def release(tag, url="", prerelease=False, draft=False):
+        item = {
+            "tag_name": tag,
+            "prerelease": prerelease,
+            "draft": draft,
+        }
+        if url:
+            item["html_url"] = url
+        return item
+
+    data = json_call(
+        ledger, cli, [
+            "update-check",
+            json.dumps([release("v2.3.0", "https://example.invalid/new")]),
