+		} else if (key == kSeekDuration
+			&& value.isDouble()
+			&& (value.toInt() == 5
+				|| value.toInt() == 10
+				|| value.toInt() == 15
+				|| value.toInt() == 30)) {
+			config.setSeekDuration(value.toInt());
+		} else if ((key == kUseEditedIcon || key == kUseEditedIconAlias)
+			&& value.isBool()) {
+			config.setUseEditedIcon(value.toBool());
