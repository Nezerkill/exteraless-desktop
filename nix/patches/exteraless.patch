+    result = run(cli, ["lyrics-parse", str(FIXTURES / "missing.lrc")])
+    ledger.check(
+        "lyrics parse missing file",
+        result.returncode == 2 and bool(result.stderr.strip()),
+        f"exit {result.returncode}, stderr {result.stderr!r}")
