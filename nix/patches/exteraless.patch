+}
+
+[[nodiscard]] constexpr int WithPillStackPill(
+		int mask,
+		PillStackPill pill,
+		bool enabled) {
+	return enabled
+		? (mask | int(pill))
+		: (mask & ~int(pill));
+}
+
+class Config final {
