diff --git a/Telegram/SourceFiles/boxes/deleted_messages_box.cpp b/Telegram/SourceFiles/boxes/deleted_messages_box.cpp
new file mode 100644
index 0000000..951edc5
--- /dev/null
+++ b/Telegram/SourceFiles/boxes/deleted_messages_box.cpp
@@ -0,0 +1,112 @@
+#include "boxes/deleted_messages_box.h"
+
+#include "exteraless/config.h"
+#include "exteraless/deleted_messages.h"
+#include "data/data_peer.h"
+#include "lang/lang_keys.h"
+#include "ui/layers/generic_box.h"
+#include "ui/widgets/labels.h"
+#include "ui/wrap/vertical_layout.h"
+#include "window/window_session_controller.h"
+#include "styles/style_boxes.h"
+#include "styles/style_layers.h"
+
+#include <QColor>
+#include <QDateTime>
+#include <QLocale>
+
+#include <algorithm>
+#include <rpl/rpl.h>
+
+namespace Exteraless {
+
+void ShowDeletedMessagesBox(
+		Window::SessionController *controller,
+		PeerData *peer) {
+	if (!controller || !peer) {
+		return;
+	}
+	const auto entries = DeletedMessages::Instance().list(peer->id);
+	const auto &config = Config::Instance();
+	const auto customMark = config.customDeletedMark();
+	const auto mark = config.useDeletedIcon()
+		? (customMark.isEmpty() ? u"🗑"_q : customMark)
+		: customMark;
+	const auto markColor = config.deletedMarkColor();
+	const auto translucent = config.translucentDeletedMessages();
+
+	controller->show(Box([=](not_null<Ui::GenericBox*> box) {
+		box->setTitle(u"Deleted messages"_q);
+		const auto layout = box->verticalLayout();
+
+		if (entries.empty()) {
+			layout->add(
+				object_ptr<Ui::FlatLabel>(
+					box,
+					rpl::single(u"No deleted messages in this chat."_q),
+					st::boxLabel),
+				st::boxRowPadding);
+		} else {
+			const auto limit = std::min<int>(entries.size(), 100);
+			for (auto i = 0; i != limit; ++i) {
+				const auto &entry = entries[i];
+				const auto date = QDateTime::fromSecsSinceEpoch(
+					entry.date).toString(u"yyyy-MM-dd HH:mm"_q);
+				auto text = entry.fromName.isEmpty()
+					? entry.text
+					: (entry.fromName + u": "_q + entry.text);
+				if (!mark.isEmpty()) {
+					text = mark + u" "_q + text;
+				}
+				if (!entry.media.isEmpty()) {
+					text += u" [media]"_q;
+				}
+				if (!entry.reactions.isEmpty()) {
+					text += u"  ["_q
+						+ entry.reactions.join(u' ')
+						+ u"]"_q;
+				}
+				if (entry.replyToMsgId) {
+					text += u"  [reply"_q;
+					if (!entry.replyToText.isEmpty()) {
+						text += u": "_q
+							+ entry.replyToText.left(40);
+					}
+					text += u"]"_q;
+				}
+				if (!entry.forwardedFrom.isEmpty()) {
+					text += u"  [forwarded from "_q
+						+ entry.forwardedFrom
+						+ u"]"_q;
+				}
+				if (entry.editedDate) {
+					text += u"  [edited]"_q;
+				}
+				if (!entry.entities.empty()) {
+					text += u"  [entities: %1]"_q.arg(
+						int(entry.entities.size()));
+				}
+				if (!entry.read) {
+					text += u"  [unread]"_q;
+				}
+				const auto label = layout->add(
+					object_ptr<Ui::FlatLabel>(
+						box,
+						rpl::single(date + u"  "_q + text),
+						st::boxLabel),
+					st::boxRowPadding);
+				if (markColor) {
+					label->setTextColorOverride(
+						QColor::fromRgba(quint32(markColor)));
+				}
+				if (translucent) {
+					label->setOpacity(0.6);
+				}
+			}
+		}
+
+		box->addButton(tr::lng_close(), [=] { box->closeBox(); });
+	}));
+}
+
+} // namespace Exteraless
