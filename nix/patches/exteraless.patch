+	return tr::lng_settings_exteraless();
+}
+
+void ExteralessSection::setupContent() {
+	const auto content = Ui::CreateChild<Ui::VerticalLayout>(this);
+	build(content, kBuild);
+	Ui::ResizeFitChild(this, content);
+}
