# Set the default behavior, in case people don't have core.autocrlf set.
* text=auto

# Ensure diffs have LF endings
*.diff text eol=lf
*.bat text eol=crlf

# Keep the zxcvbn word lists byte-identical to upstream so their digests hold
Telegram/Resources/zxcvbn/*.txt text eol=lf

# Ensure lottie animations are treated as binary files
*.lottie binary

# Subtitle fixtures must keep their exact bytes: basic.srt tests CRLF input
exteraless/tests/chats/fixtures/*.srt -text

# The Nix patch embeds fixture bytes (incl. CRLF); must stay byte-identical
nix/patches/exteraless.patch -text
